# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Backend API (apps/backend)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL + PostGIS
# Port 5434 (not the default 5432) to avoid clashing with other local projects' containers.
DATABASE_URL=postgresql://mrv_user:mrv_password@localhost:5434/blue_carbon_mrv
POSTGRES_USER=mrv_user
POSTGRES_PASSWORD=mrv_password
POSTGRES_DB=blue_carbon_mrv
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-real-deployments
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Object storage (S3-compatible; MinIO locally, AWS S3 in production)
# MinIO API on 9002 / console on 9003 (not the default 9000/9001) to avoid port clashes.
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_PATH=./local-storage # resolved relative to apps/backend, not the repo root
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=blue-carbon-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# AI/ML service
ML_SERVICE_URL=http://localhost:8010
ML_SERVICE_TIMEOUT_MS=30000

# Duplicate detection thresholds
DUPLICATE_PROXIMITY_METERS=50
DUPLICATE_TIME_WINDOW_HOURS=48

# Hyperledger Fabric (see network/README.md to stand up the network first)
FABRIC_ENABLED=false # set true once `network.sh up createChannel -s couchdb` + chaincode deploy succeed
FABRIC_CHANNEL_NAME=mrvchannel
FABRIC_CHAINCODE_NAME=mrv-contract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Paths below point at crypto material network.sh generates under
# <fabric-samples>/test-network/organizations/ - only meaningful once the network is up.
# On Windows, fabric-samples must be cloned OUTSIDE this repo (see network/README.md - Fabric's
# own scripts break on paths with spaces), so these are absolute, machine-specific paths - adjust
# to wherever you cloned it. On macOS/Linux without spaces in your path, the relative
# ./network/fabric-samples/... form works fine if you clone it inside network/ as usual.
# Use Windows-drive-letter style (C:/... or C:\...), not git-bash's /c/... form - Node's
# path.isAbsolute() on win32 doesn't recognize /c/... as absolute, which would make the backend
# wrongly try to resolve it relative to the repo root.
FABRIC_TLS_CERT_PATH=C:/Users/<you>/fabric-dev/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_CERT_DIRECTORY_PATH=C:/Users/<you>/fabric-dev/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/
FABRIC_KEY_DIRECTORY_PATH=C:/Users/<you>/fabric-dev/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ---------------------------------------------------------------------------
# Web dashboard (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------------------------------------------------------------------------
# ML service (ml-service)
# ---------------------------------------------------------------------------
ML_MODEL_MODE=heuristic # heuristic | pretrained
# Port 8010 (not the default 8000) to avoid clashing with other local projects' dev servers.
ML_SERVICE_PORT=8010
